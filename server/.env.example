# ARIA Sidecar Environment Variables
# Copy this file to .env and fill in the values

# Workspace Root (default: current directory)
# WORKSPACE_ROOT=/path/to/your/project

# Server Configuration
# HOST=127.0.0.1
# PORT=8000

# Security
# ARIA_ACCESS_TOKEN will be auto-generated on startup
# If you want to set a custom token, uncomment and set:
# ARIA_ACCESS_TOKEN=your-custom-token-here
